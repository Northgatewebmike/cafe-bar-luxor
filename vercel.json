{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/manus-storage/(.*)",
      "dest": "https://cafeluxor-tosj4glv.manus.space/manus-storage/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
